# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 数据适配器的产物：逐样本展开后约 220 MB，不进版本库。
# 用 `python src/cli.py build` 可以随时从 GivenData/ 重新生成。
data/processed/

# 复现产物的落点约定。数据质量报告（data/reports/*.json）体积很小，
# 是"我们查到了什么"的留档证据，因此**不入本忽略规则**，应当提交。
runs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 角色④（检索线）的构建产物：语料与索引体积大，且可由脚本重建。
# 构建脚本本身（rag/corpus/*.py）必须提交。
rag/corpus/corpus.jsonl
rag/index/

# 角色①（部署线）的离线打包产物：镜像 tar 包极大，不进版本库。
deploy/dist/

# 基座模型权重：Qwen2.5-3B 约 6.2 GB，绝不能进版本库。
# 每台机器用 `python tools/fetch_model.py` 自己下（支持断点续传）。
# 打包镜像时这些权重会被拷进镜像，那才是它的正确去处。
GivenData/participant/model/
GivenData/participant/model-*/
*.safetensors
*.safetensors.part

# pip 有时会把解包临时目录建在当前工作目录（而不是系统 TEMP）。
# 2026-10-15 踩过一次：`git add -A` 把 1.9 GB 的 torch wheel 扫进了提交。
# 双保险：这里挡住，同时 tools/bootstrap.py 会把 TEMP/TMPDIR 指到系统临时目录。
pip-*/
/tmp*

# torch 的 Inductor 编译器有时把缓存目录建在当前工作目录（如 torchinductor_<用户名>/）。
torchinductor_*/
# 本地临时取回的文件，不进版本库
tmp/
deploy/.corpus-build.log
